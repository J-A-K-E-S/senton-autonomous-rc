<launch>

    <let name="urdf_path"
         value="$(find-pkg-share senton_description)/urdf/senton.urdf.xacro"/>

    <node pkg="robot_state_publisher"
          exec="robot_state_publisher">
        <param name="robot_description"
               value="$(command 'xacro $(var urdf_path)')"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Gazebo -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="empty.sdf -r"/>
    </include>

    <!-- Bridge Gazebo simulation clock into ROS -->
    <node pkg="ros_gz_bridge"
          exec="parameter_bridge"
          args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock"
          output="screen"/>

    <!-- Spawn SENTON -->
    <node pkg="ros_gz_sim"
          exec="create"
          output="screen"
          args="-topic robot_description -name senton"/>

    <!-- Controllers -->
    <node pkg="controller_manager"
          exec="spawner"
          args="joint_state_broadcaster"
          output="screen"/>

    <node pkg="controller_manager"
          exec="spawner"
          args="ackermann_controller"
          output="screen"/>

    <!-- RViz -->
    <node pkg="rviz2"
          exec="rviz2"
          output="screen"
          args="-d $(find-pkg-share senton_description)/rviz/senton.rviz">
        <param name="use_sim_time" value="true"/>
    </node>
    <node pkg="topic_tools"
      exec="relay"
      name="odom_tf_relay"
      args="/ackermann_controller/tf_odometry /tf"
      output="screen"/>

</launch>