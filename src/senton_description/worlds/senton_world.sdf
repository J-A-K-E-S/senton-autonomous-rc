<?xml version="1.0"?>
<!--
  SENTON test world — scout hall approximation.

  Layout (viewed from above, x to the right, y up):

      +===========================================+   y = +4
      |                                           |
      |        +=========================+        |
      |        |        ISLAND           |        |
      |        +=========================+        |
      |                                           |
      +===========================================+   y = -4
    x = -6                                       x = +6

  The car laps the gap between the island and the walls.
  Lane width: 3.0 m on the ends, 2.0 m on the sides.

  TO RESIZE: change HALL_X, HALL_Y, ISLAND_X, ISLAND_Y below by editing
  the <pose> and <size> values marked with each name. SDF has no
  variables, so the numbers are written out.

      HALL_X   = 12.0   half = 6.0
      HALL_Y   =  8.0   half = 4.0
      ISLAND_X =  6.0   half = 3.0
      ISLAND_Y =  4.0   half = 2.0
      WALL_H   =  1.0
      WALL_T   =  0.1
-->
<sdf version="1.9">
  <world name="senton_world">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ================= ground ================= -->

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- polished wooden floor: lower grip than tarmac -->
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.35 0.25 1</ambient>
            <diffuse>0.55 0.42 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= hall walls ================= -->
    <!-- Each wall is one static box. Length overruns by WALL_T so the
         corners close cleanly with no gap for the LIDAR to see through. -->

    <model name="wall_north">
      <static>true</static>
      <!-- pose: 0, +HALL_Y/2, WALL_H/2 -->
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <!-- size: HALL_X + WALL_T, WALL_T, WALL_H -->
            <box><size>12.1 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12.1 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12.1 0.1 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12.1 0.1 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <!-- pose: +HALL_X/2, 0, WALL_H/2 -->
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <!-- size: WALL_T, HALL_Y, WALL_H -->
          <geometry>
            <box><size>0.1 8.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 8.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.1 8.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.1 8.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.85 0.85 0.82 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= centre island ================= -->
    <!-- Stands in for the tables laid on their sides. Move this model
         off-centre or rotate it to change the track shape without
         touching anything else. -->

    <model name="island">
      <static>true</static>
      <!-- pose: 0, 0, ISLAND_H/2 -->
      <pose>0 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <!-- size: ISLAND_X, ISLAND_Y, ISLAND_H -->
          <geometry>
            <box><size>6.0 4.0 0.7</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 4.0 0.7</size></box>
          </geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient>
            <diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= optional chicane =================
         Uncomment to narrow the north straight and give the planner
         something to work around. Represents one extra table.

    <model name="chicane">
      <static>true</static>
      <pose>-2.5 2.6 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.6 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.6 0.7</size></box></geometry>
          <material>
            <ambient>0.30 0.32 0.35 1</ambient>
            <diffuse>0.38 0.40 0.44 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    -->

  </world>
</sdf>
